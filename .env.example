# Use the same origin in the browser and Supabase Auth redirect allow-list.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Required for Milestone 1. Copy the public values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# No service-role key, database password, AI or Maps key is needed for M1.
# Never add server secrets with a NEXT_PUBLIC_ prefix.
